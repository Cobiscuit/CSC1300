[
  {
    "label": "Debug current C++ file",
    "adapter": "CodeLLDB",
    "request": "launch",

    "build": {
      "command": "g++",
      "args": [
        "-std=c++17",
        "-g",
        "-O0",
        "$ZED_FILE",
        "-o",
        "$ZED_DIRNAME/$ZED_STEM"
      ],
      "cwd": "$ZED_DIRNAME"
    },

    "program": "$ZED_DIRNAME/$ZED_STEM",
    "cwd": "$ZED_DIRNAME",
    "terminal": "integrated"
  }
]